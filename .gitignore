# Composer + test harness build artifacts.
# Everything under .Build/ is generated by `composer install` and the
# typo3/testing-framework (vendor/, bin/, the .Build/public web root used for
# functional tests, and the .Build/.cache PHPUnit cache). Never commit it.
/.Build/

# TYPO3 v14 resolves packages/ext, packages/sysext and packages/autoload relative
# to the project root. Because web-dir is .Build/public, the package root acts as
# the project root for the local test instance, so TYPO3 dumps its class loading
# information here. Generated, like .Build/.
/packages/

# TYPO3 runtime data (caches, logs, locks, sessions, var/transient for generated
# Fluid schemas), resolved to the project root in Composer mode. Matches the other
# MPC extensions. public/ and vendor/ only appear if someone installs without the
# .Build layout, but are ignored for the same reason.
/var/
/public/
/vendor/

# Extensions do not ship a lock file; the integrating project pins versions.
/composer.lock

# PHPUnit / PHPStan caches, in case a run writes them to the package root
# instead of into .Build/.cache.
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan/
/.php-cs-fixer.cache

# Local secrets / credentials — must never be committed.
# (DeepL keys, Composer auth tokens, local env overrides.)
/auth.json
/.env
/.env.*

# OS / editor noise
.DS_Store
Thumbs.db

# Codeception generated output
/Tests/Acceptance/_output/
/Tests/Acceptance/Support/_generated/
