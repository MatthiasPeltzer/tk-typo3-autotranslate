{
    "name": "thieleundklose/autotranslate",
    "type": "typo3-cms-extension",
    "description": "This extension provides automatic translation of pages and content elements via DeepL API.",
    "authors": [
        {
            "name": "Mike Zimmer",
            "email": "typo3@thieleundklose.de",
            "homepage": "https://www.thieleundklose.de",
            "role": "Developer"
        }
    ],
    "version": "3.0.9",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">= 8.2 < 8.6",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "typo3/cms-core": "^13.4 || ^14.0",
        "deeplcom/deepl-php": "^1.5"
    },
    "require-dev": {
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.0",
        "codeception/module-cli": "^2.0",
        "codeception/module-webdriver": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/testing-framework": "^9.3",
        "typo3/coding-standards": "^0.8.0",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-install": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "ThieleUndKlose\\Autotranslate\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThieleUndKlose\\Autotranslate\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/autotranslate": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:coverage": "phpunit -c Build/phpunit/UnitTests.xml --coverage-text --coverage-html .Build/coverage",
        "test:acceptance": "codecept run -c codeception.yml --env headless",
        "phpstan": "phpstan analyse -c Build/phpstan.neon --memory-limit=1G",
        "analyse": "@phpstan",
        "cs": "php .Build/bin/php-cs-fixer fix --dry-run -v --config .php-cs-fixer.dist.php",
        "cs:fix": "php .Build/bin/php-cs-fixer fix -v --config .php-cs-fixer.dist.php",
        "lint:php": "find Classes Tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint:yaml": "find Configuration -name '*.yaml' -o -name '*.yml' | xargs -r .Build/bin/yaml-lint --parse-tags",
        "lint:typoscript": "php Build/Scripts/lintTypoScript.php",
        "lint:all": [
            "@lint:php",
            "@lint:yaml",
            "@lint:typoscript"
        ]
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "extension-key": "autotranslate",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
